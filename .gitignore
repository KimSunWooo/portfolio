# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
frontend/playwright-report/
frontend/test-results/

# next.js
/.next/
/out/
frontend/.next/
**/.next/

# production / build caches
/build
backend/build/
.gradle/

# misc
.DS_Store
*.pem

# debug / local measurement noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
tmp/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
.pytest_cache/

#crowler
/hince-importer
/data_crawler.py
/dummy_products_relational.sql

# Local Properties (보안 파일 제외)
application-local.properties