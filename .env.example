# 로컬 예시이다. 운영 값이나 개인 .env를 복사하지 않는다.
# 개인 .env가 있으면 이 파일로 덮어쓰지 않는다.
#
# 처음 실행은 루트 docker-compose.yml이 아니라 격리 스택을 쓴다.
#   docker compose -f compose.verify.yml up -d
#   cd backend && ./gradlew bootRun --args='--spring.profiles.active=verify'
# verify 프로파일은 backend/src/main/resources/application-verify.properties에
# 로컬 MySQL, Redis, JWT, 메일, S3, 결제 placeholder가 있다.
# RabbitMQ와 Kafka 플래그는 false다.

# 브라우저에 노출된다. 비우면 프론트는 http://localhost:8080 을 쓴다.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Next.js 서버 전용. 브라우저 번들에 넣지 않는다.
INTERNAL_API_URL=http://localhost:8080
# 홈 일부 경로가 참조한다. NEXT_PUBLIC_API_URL과 역할이 다르다.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# 아래는 verify 프로파일을 쓰지 않고 직접 기동할 때의 이름이다.
# 값이 없으면 기동이 환경변수 누락으로 실패한다.
JWT_SECRET=local-only-change-me-32chars-minimum
AWS_ACCESS_KEY_ID=local-only
AWS_SECRET_ACCESS_KEY=local-only
TOSS_SECRET_KEY=local-only-not-a-payment-key
GOOGLE_MAIL_PASSWORD=local-only-not-a-mailbox
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# 선택. 비우면 Cafe24 연동은 설정되지 않는다.
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=

# 운영 프로파일에서만 사용한다. 로컬 verify에는 넣지 않는다.
# DB_PASSWORD=

# 메시징은 기본 비활성이다. compose.messaging.yml을 띄운 뒤에만 채운다.
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
# 그리고 애플리케이션 플래그:
# app.notification.password-changed.enabled=true
# app.analytics.product-detail-read.enabled=true
